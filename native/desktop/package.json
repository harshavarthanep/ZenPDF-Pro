{
  "name": "zenpdf-pro",
  "productName": "ZenPDF Pro",
  "version": "1.0.0",
  "description": "ZenPDF Pro — every PDF tool, private and on your device. Built by H24 Creationz.",
  "author": { "name": "H24 Creationz", "email": "harshavarthanep@gmail.com" },
  "homepage": "https://github.com/harshavarthanep/ZenPDF-Pro",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-www": "node ../shared/prepare-www.mjs www",
    "start": "npm run prepare-www && electron .",
    "build:win": "npm run prepare-www && electron-builder --win --publish never",
    "build:mac": "npm run prepare-www && electron-builder --mac --publish never",
    "build:linux": "npm run prepare-www && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.h24creationz.zenpdfpro",
    "productName": "ZenPDF Pro",
    "copyright": "Copyright © H24 Creationz",
    "files": ["main.js", "preload.js", "www/**/*", "build/icon.png", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "asar": true,
    "fileAssociations": [
      { "ext": "pdf", "name": "PDF Document", "description": "PDF document", "mimeType": "application/pdf", "role": "Editor" }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "ZenPDF-Pro-Setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZenPDF Pro",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "ZenPDF-Pro-Portable.${ext}" },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": { "artifactName": "ZenPDF-Pro-Mac.${ext}", "title": "ZenPDF Pro" },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "H24 Creationz",
      "synopsis": "Every PDF tool, private and on your device",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "appImage": { "artifactName": "ZenPDF-Pro-Linux.${ext}" },
    "deb": { "artifactName": "ZenPDF-Pro-Linux.${ext}" }
  }
}
