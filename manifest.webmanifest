{
  "name": "ZenPDF Pro",
  "short_name": "ZenPDF Pro",
  "description": "Every PDF tool — edit, sign, fill, merge, compress, convert — private and on your device. Built by H24 Creationz.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f6f3",
  "theme_color": "#f6f6f3",
  "categories": ["productivity", "utilities", "business"],
  "file_handlers": [{ "action": "./", "accept": { "application/pdf": [".pdf"] } }],
  "icons": [
    { "src": "./zenpdf-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./zenpdf-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./zenpdf-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
